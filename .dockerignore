# Keep the build context small and secrets OUT of the image.

# Dependencies & build output are recreated inside the image.
**/node_modules
**/dist
**/dist-ssr

# Secrets — NEVER copy any real env file into the build context. VITE_* values
# are supplied as build args; backend config is injected at runtime.
.env
.env.*
render-upload.env

# VCS / tooling / editor noise
.git
.gitignore
.github
.claude
.vscode
.idea
**/.DS_Store

# Logs & local caches
*.log
logs
npm-debug.log*

# Build/deploy metadata — not needed inside the image. (Only root-level files are
# listed here; the Dockerfile copies frontend/ and backend/ manifests explicitly,
# so we must NOT add bare `package.json`/`package-lock.json` patterns.)
Dockerfile
.dockerignore
render.yaml
Readme.md
