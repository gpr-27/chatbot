# =============================================================================
# Single shared environment template for Groqbot (backend + frontend).
# Copy to `.env` in this repo root and fill in real values:  cp .env.example .env
#
# There is exactly ONE .env for the whole project. The backend reads all vars;
# Vite (frontend) reads the SAME file via `envDir` but only exposes VITE_-prefixed
# vars to the client — so backend secrets here are never shipped to the browser.
# `.env` is gitignored; this `.env.example` holds placeholders only.
# =============================================================================

# ── Server (backend) ──────────────────────────────────────
# Port the API server listens on
PORT=5001
# Runtime mode: development | production
NODE_ENV=development
# Logging verbosity: error | warn | info | debug
LOG_LEVEL=info

# ── Database (backend) ────────────────────────────────────
# Local MongoDB or a MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/groqbot

# ── Clerk auth ────────────────────────────────────────────
# Get keys at https://dashboard.clerk.com/~/api-keys
# Backend needs both; the frontend needs the publishable key (VITE_ below).
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# ── Guest accounts ────────────────────────────────────────
# Days of inactivity before an anonymous guest account is auto-deleted (TTL).
GUEST_RETENTION_DAYS=30

# ── CORS / client origin (backend) ────────────────────────
# Origin allowed by CORS (the frontend URL)
CLIENT_URL=http://localhost:5173

# ── AI / LLM (backend) ────────────────────────────────────
# Active LLM provider. The API-key variable name is DERIVED from this:
#   groq → GROQ_API_KEY, openai → OPENAI_API_KEY, etc.
LLM_PROVIDER=groq
# Credential for the active provider (name = <PROVIDER>_API_KEY).
GROQ_API_KEY=your_groq_api_key_here
# Default model used for chat completions (must be in AVAILABLE_MODELS)
DEFAULT_MODEL=llama-3.3-70b-versatile
# Comma-separated allow-list of selectable models
AVAILABLE_MODELS=llama-3.1-8b-instant,llama-3.3-70b-versatile,openai/gpt-oss-120b,openai/gpt-oss-20b,openai/gpt-oss-safeguard-20b,qwen/qwen3-32b,groq/compound,groq/compound-mini
# (optional) Smaller/faster model used to auto-generate conversation titles
TITLE_MODEL=llama-3.1-8b-instant
# (optional) Human-friendly labels: id:Label pairs, comma-separated
MODEL_LABELS=llama-3.1-8b-instant:Llama 3.1 8B,llama-3.3-70b-versatile:Llama 3.3 70B,openai/gpt-oss-120b:GPT-OSS 120B,openai/gpt-oss-20b:GPT-OSS 20B,openai/gpt-oss-safeguard-20b:GPT-OSS Safeguard 20B,qwen/qwen3-32b:Qwen 3 32B,groq/compound:Groq Compound,groq/compound-mini:Groq Compound Mini

# ── Frontend (Vite) — ONLY VITE_* are exposed to the client ──
# Base URL of the backend API (in production, the deployed origin)
VITE_API_URL=http://localhost:5001
# (optional) Socket/SSE base URL — leave blank to reuse VITE_API_URL
VITE_SOCKET_URL=
# Build/runtime mode: development | production
VITE_APP_ENV=development
# Clerk publishable key (same value as CLERK_PUBLISHABLE_KEY above)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
# Active LLM provider (informational, mirrors backend)
VITE_LLM_PROVIDER=groq
# Default model pre-selected in the UI
VITE_DEFAULT_MODEL=llama-3.3-70b-versatile
# Comma-separated allow-list of selectable models
VITE_AVAILABLE_MODELS=llama-3.1-8b-instant,llama-3.3-70b-versatile,openai/gpt-oss-120b,openai/gpt-oss-20b,openai/gpt-oss-safeguard-20b,qwen/qwen3-32b,groq/compound,groq/compound-mini
# (optional) Human-friendly labels: id:Label pairs, comma-separated
VITE_MODEL_LABELS=llama-3.1-8b-instant:Llama 3.1 8B,llama-3.3-70b-versatile:Llama 3.3 70B,openai/gpt-oss-120b:GPT-OSS 120B,openai/gpt-oss-20b:GPT-OSS 20B,openai/gpt-oss-safeguard-20b:GPT-OSS Safeguard 20B,qwen/qwen3-32b:Qwen 3 32B,groq/compound:Groq Compound,groq/compound-mini:Groq Compound Mini
